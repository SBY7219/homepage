{
  "name": "shibingyi-static-writing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs --publish",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --no-watch",
    "test": "node --test lib/article/*.test.mjs test/compiler.test.mjs test/publish.test.mjs",
    "test:site": "node --test test/site.test.mjs test/catalog.test.mjs",
    "check:published": "node scripts/build.mjs --check"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "esbuild": "^0.25.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.0",
    "minisearch": "^7.2.0",
    "parse5": "^8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.0"
  }
}
